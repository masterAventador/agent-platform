# Copy to .env.litellm, replace the master key, and set a real provider key locally.
# LiteLLM requires its gateway master key to start with sk-.
LITELLM_MASTER_KEY=sk-CHANGE_ME_LITELLM_MASTER_KEY
# Generate a different high-entropy key locally. Bootstrap registers it as a
# virtual key limited to general-purpose inference; never reuse the master key.
LITELLM_WORKER_API_KEY=sk-CHANGE_ME_LITELLM_WORKER_KEY
LITELLM_PORT=4000

LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=CHANGE_ME_LITELLM_DB_PASSWORD

# The platform calls only the stable alias "general-purpose". Provider selection stays here.
LITELLM_UPSTREAM_MODEL=dashscope/qwen-plus
LITELLM_UPSTREAM_API_KEY=
# Optional for the documented DashScope/Volcengine defaults. Set it explicitly for
# custom or OpenAI-compatible endpoints; re-audit empty-value behavior on upgrades.
LITELLM_UPSTREAM_API_BASE=
