# Copy to .env.platform and replace every CHANGE_ME value before starting services.
POSTGRES_DB=agent_platform
POSTGRES_USER=agent_platform
POSTGRES_PASSWORD=CHANGE_ME_PLATFORM_POSTGRES
POSTGRES_PORT=5432

REDIS_PASSWORD=CHANGE_ME_PLATFORM_REDIS
REDIS_PORT=6379

MINIO_ROOT_USER=agent_platform
MINIO_ROOT_PASSWORD=CHANGE_ME_PLATFORM_MINIO
MINIO_API_PORT=9000

PLATFORM_API_PORT=8000
PLATFORM_WEB_PORT=8080
RAGFLOW_URL=http://host.docker.internal:19380
RAGFLOW_API_KEY=
# 本机同源开发保持 false/lax；Tauri 直连正式 HTTPS API 必须使用 true/none。
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://host.docker.internal:4317
DISPATCHER_BATCH_SIZE=100
DISPATCHER_IDLE_BACKOFF_SECONDS=0.5

# Worker is opt-in: docker compose --profile worker ... up worker
# This must match the scoped LITELLM_WORKER_API_KEY, never LITELLM_MASTER_KEY.
AGENT_PLATFORM_LLM_GATEWAY_URL=http://litellm:4000/v1
AGENT_PLATFORM_LLM_GATEWAY_API_KEY=sk-CHANGE_ME_LITELLM_WORKER_KEY
AGENT_PLATFORM_QUEUE_PENDING_MIN_IDLE_MS=1000
AGENT_PLATFORM_QUEUE_MAX_DELIVERY_ATTEMPTS=5
AGENT_PLATFORM_RUN_QUEUE_DEAD_LETTER_STREAM_NAME=agent-platform:runs:dlq
AGENT_PLATFORM_WORKER_RETRY_BACKOFF_SECONDS=1.0
SANDBOX_TTL_SECONDS=3600
SANDBOX_CONTROLLER_REQUEST_TIMEOUT_SECONDS=130
SANDBOX_JANITOR_INTERVAL_SECONDS=30
SANDBOX_JANITOR_BATCH_SIZE=100
# 本机/CI 独立 Docker Sandbox Controller；不得复用生产凭据。
SANDBOX_CONTROLLER_BEARER_SECRET=replace-with-at-least-16-random-characters
# 只允许 linux/arm64 且必须锁定 sha256 digest，禁止 latest/tag-only。
SANDBOX_CONTROLLER_IMAGE=python:3.12.13-slim-bookworm@sha256:8a7e7cc04fd3e2bd787f7f24e22d5d119aa590d429b50c95dfe12b3abe52f48b
# 这是 Docker daemon 所在环境可见的路径；Colima/常规Linux保持默认值。
# 不要填宿主机 ~/.colima/... 路径，它在 Colima VM 内不可见。
DOCKER_SOCKET_PATH=/var/run/docker.sock
