# Copy to .env.platform and replace every CHANGE_ME value before starting services.
POSTGRES_DB=agent_platform
POSTGRES_USER=agent_platform
POSTGRES_PASSWORD=CHANGE_ME_PLATFORM_POSTGRES
POSTGRES_PORT=5432

REDIS_PASSWORD=CHANGE_ME_PLATFORM_REDIS
REDIS_PORT=6379

MINIO_ROOT_USER=agent_platform
MINIO_ROOT_PASSWORD=CHANGE_ME_PLATFORM_MINIO
MINIO_API_PORT=9000

PLATFORM_API_PORT=8000
PLATFORM_WEB_PORT=8080
RAGFLOW_URL=http://host.docker.internal:19380
RAGFLOW_API_KEY=
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://host.docker.internal:4317

# Worker is opt-in: docker compose --profile worker ... up worker
# Do not invent an adapter path or fake key. Export only real local configuration.
AGENT_PLATFORM_RUNTIME_ADAPTER_FACTORY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
