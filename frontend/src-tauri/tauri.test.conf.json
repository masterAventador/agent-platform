{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeBuildCommand": "pnpm build --mode tauri-test"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "desktop-test",
          "description": "仅供 WebdriverIO 桌面自动化构建使用",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:allow-open",
            "dialog:allow-save",
            "fs:allow-read-file",
            "fs:allow-write-file",
            "notification:default",
            "opener:allow-open-url",
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  }
}
