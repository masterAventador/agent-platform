        "governance": {
          "$ref": "#/$defs/GovernanceReferences"
        },
        "identity": {
          "$ref": "#/$defs/LocalTaskIdentity"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "message_type": {
          "const": "task.error",
          "title": "Message Type",
          "type": "string"
        },
        "protocol_version": {
          "const": "1.0",
          "title": "Protocol Version",
          "type": "string"
        },
        "retry_after_ms": {
          "anyOf": [
            {
              "maximum": 86400000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Ms"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "safe_message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Safe Message",
          "type": "string"
        },
        "sent_at": {
          "format": "date-time",
          "title": "Sent At",
          "type": "string"
        }
